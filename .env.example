# IONOS SMTP (Vercel Serverless Function)
SMTP_HOST=smtp.ionos.de
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=webseite@kfz-lindner.de
SMTP_PASS=replace-with-secret

# Website mailbox receiving internal form notifications
MAIL_TO=webseite@kfz-lindner.de

# Authenticated sender address (keep aligned with SMTP_USER)
MAIL_FROM=webseite@kfz-lindner.de
